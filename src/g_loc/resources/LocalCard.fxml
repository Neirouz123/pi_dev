<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.LocalCardController"
      styleClass="local-card" 
      style="-fx-background-color: white; 
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);
             -fx-background-radius: 8;
             -fx-border-radius: 8;
             -fx-min-width: 280;
             -fx-pref-width: 300;
             -fx-max-width: 360;
             -fx-spacing: 0;
             -fx-padding: 0;
             -fx-border-color: #e0e0e0;
             -fx-border-width: 1;">

    <!-- Image Container -->
    <StackPane>
        <!-- Main Image - Fixed size and styling -->
        <ImageView fx:id="mainImage" fitWidth="300" fitHeight="160" 
                   preserveRatio="false"
                   style="-fx-background-color: #f5f5f5;">
        </ImageView>
        
        <!-- Venue Name Overlay -->
        <VBox alignment="BOTTOM_LEFT" style="-fx-background-color: linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,0.7));
                                             -fx-padding: 10;">
            <Label fx:id="nomLabel" 
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;
                          -fx-wrap-text: true;" maxWidth="260"/>
        </VBox>
                  
        <!-- Availability Badge -->
        <HBox fx:id="disponibiliteLabel" spacing="5" alignment="CENTER"
              style="-fx-background-color: #4CAF50; -fx-padding: 4 8; -fx-background-radius: 4;"
              StackPane.alignment="TOP_RIGHT">
            <Circle fx:id="statusDot" radius="3" fill="white"/>
            <Label fx:id="statusText" text="Available" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <StackPane.margin>
                <Insets top="8" right="8"/>
            </StackPane.margin>
        </HBox>

        <!-- Price Badge -->
        <Label fx:id="prixLabel" 
               style="-fx-background-color: #1976D2; 
                      -fx-text-fill: white; 
                      -fx-font-weight: bold;
                      -fx-padding: 4 8;
                      -fx-background-radius: 4;"
               StackPane.alignment="TOP_LEFT">
            <StackPane.margin>
                <Insets top="8" left="8"/>
            </StackPane.margin>
        </Label>
    </StackPane>

    <!-- Content Container with Better Spacing -->
    <VBox spacing="8" style="-fx-padding: 12;" VBox.vgrow="ALWAYS">
        <!-- Location with icon -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="📍" style="-fx-font-size: 14;"/>
            <Label fx:id="adresseLabel" style="-fx-font-size: 13; -fx-text-fill: #555; -fx-wrap-text: true;" 
                   HBox.hgrow="ALWAYS" maxWidth="240"/>
        </HBox>
        
        <!-- Capacity with icon -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="👥" style="-fx-font-size: 14;"/>
            <Label fx:id="capaciteLabel" style="-fx-font-size: 13; -fx-text-fill: #555;"/>
        </HBox>
        
        <!-- Category Badge -->
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="categoryLabel" text="Standard" 
                   style="-fx-font-size: 11; 
                          -fx-text-fill: #757575; 
                          -fx-background-color: #f5f5f5; 
                          -fx-padding: 2 8; 
                          -fx-background-radius: 4;"/>
        </HBox>
        
        <!-- Spacer to push buttons to bottom -->
        <Region VBox.vgrow="ALWAYS" />
        
        <!-- Action Buttons -->
        <HBox spacing="8" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
            <Button fx:id="detailsButton" text="View Details" onAction="#handleDetails"
                    style="-fx-background-color: white; 
                           -fx-border-color: #1976D2; 
                           -fx-text-fill: #1976D2; 
                           -fx-background-radius: 4;
                           -fx-border-radius: 4;
                           -fx-padding: 6 12;
                           -fx-font-size: 12;
                           -fx-cursor: hand;"/>
            <Button fx:id="reserverButton" text="Book Now" onAction="#handleReserver"
                    style="-fx-background-color: #1976D2; 
                           -fx-text-fill: white; 
                           -fx-background-radius: 4;
                           -fx-padding: 6 12;
                           -fx-font-size: 12;
                           -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#1976D244" radius="6" spread="0.05" />
                </effect>
            </Button>
        </HBox>
    </VBox>
</VBox> 