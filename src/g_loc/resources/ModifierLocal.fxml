<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="600.0" style="-fx-background-color: #f5f5f5; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ModifierLocal">

    <VBox alignment="CENTER_LEFT" spacing="15">

        <!-- Title -->
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Modifier Local" />

        <!-- Nom -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 16px;" text="Nom:" />
            <TextField fx:id="nomField" promptText="Nom du local" />
        </HBox>

        <!-- Adresse -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 16px;" text="Adresse:" />
            <TextField fx:id="adresseField" promptText="Adresse du local" />
        </HBox>

        <!-- Description -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 16px;" text="Description:" />
            <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Description" wrapText="true" />
        </HBox>

        <!-- Image -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 16px;" text="Image:" />
            <Button onAction="#choisirImage" text="Choisir Image" />
            <ImageView fx:id="imageView" fitHeight="100" fitWidth="100" preserveRatio="true" />
        </HBox>

        <!-- Capacité -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 16px;" text="Capacité:" />
            <TextField fx:id="capaciteField" promptText="Capacité" />
        </HBox>

        <!-- Disponibilité -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 16px;" text="Disponibilité:" />
            <CheckBox fx:id="disponibleCheckBox" text="Disponible" />
        </HBox>

        <!-- Prix -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 16px;" text="Prix:" />
            <TextField fx:id="prixField" promptText="Prix (DT)" />
        </HBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="save" onAction="#enregistrerLocal" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Enregistrer" />
            <Button fx:id="supprimer" onAction="#supprimerLocal" style="-fx-background-color: #FF5722; -fx-text-fill: white;" text="Supprimer" />
            <Button fx:id="cancel" onAction="#annuler" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Annuler" />

        </HBox>

    </VBox>
</AnchorPane>
