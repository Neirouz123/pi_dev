<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.VenueBackofficeController"
      spacing="20" style="-fx-background-color: white; -fx-padding: 20;"
      prefWidth="1200.0" prefHeight="800.0"
      VBox.vgrow="ALWAYS">
      
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10" minHeight="60">
        <Label text="Venue Management Backoffice" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333333;">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        
        <HBox HBox.hgrow="ALWAYS" /> <!-- Spacer -->
        
        <!-- Search Field -->
        <TextField fx:id="searchField" promptText="Search venues..." prefWidth="250">
            <HBox.margin>
                <Insets right="10" />
            </HBox.margin>
        </TextField>
        
        <!-- Create Button -->
        <Button fx:id="createButton" text="Create New Venue" onAction="#handleCreateVenue"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;">
            <padding>
                <Insets top="8" right="15" bottom="8" left="15" />
            </padding>
        </Button>
    </HBox>
    
    <!-- Table Container -->
    <HBox VBox.vgrow="ALWAYS">
        <!-- Table View for Venues -->
        <TableView fx:id="venueTable" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" minWidth="50" prefWidth="50" />
                <TableColumn fx:id="nameColumn" text="Name" minWidth="120" prefWidth="150" />
                <TableColumn fx:id="addressColumn" text="Address" minWidth="150" prefWidth="200" />
                <TableColumn fx:id="capacityColumn" text="Capacity" minWidth="80" prefWidth="100" />
                <TableColumn fx:id="priceColumn" text="Price" minWidth="80" prefWidth="100" />
                <TableColumn fx:id="availabilityColumn" text="Available" minWidth="80" prefWidth="100" />
                <TableColumn fx:id="actionsColumn" text="Actions" minWidth="120" prefWidth="150" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </HBox>
    
    <!-- Status Bar -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f5f5f5; -fx-padding: 10;" minHeight="50">
        <Label fx:id="statusLabel" text="Ready" style="-fx-text-fill: #757575;" />
        
        <HBox HBox.hgrow="ALWAYS" /> <!-- Spacer -->
        
        <!-- Pagination Controls -->
        <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="5" />
    </HBox>
</VBox> 