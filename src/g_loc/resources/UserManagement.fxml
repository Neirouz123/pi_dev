<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.UserManagementController">
    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <children>
                <Label text="User Management" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2d3748;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#refreshReservations" text="Refresh" style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;" />
            </children>
        </HBox>

        <!-- Search and Filters -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f7fafc; -fx-padding: 15;">
            <children>
                <Label text="Search Users:" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" />
                <TextField fx:id="searchField" prefWidth="300.0" promptText="Search by username, role, or email..." style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-padding: 8 12;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="statusLabel" text="Ready" style="-fx-text-fill: #6b7280;" />
            </children>
        </HBox>

        <!-- Users Table -->
        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="usernameColumn" prefWidth="150.0" text="Username" />
                <TableColumn fx:id="roleColumn" prefWidth="100.0" text="Role" />
                <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email" />
                <TableColumn fx:id="createdAtColumn" prefWidth="150.0" text="Created At" />
                <TableColumn fx:id="actionsColumn" prefWidth="150.0" text="Actions" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
