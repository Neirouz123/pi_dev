<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminDashboardController">
    <top>
        <!-- Header -->
        <VBox style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 20;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label text="🏢 EventaPlan Admin" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="welcomeLabel" text="Welcome, Admin" textFill="#E8E8E8">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Button onAction="#logout" text="🚪 Logout" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8 15; -fx-cursor: hand;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <left>
        <!-- Navigation Sidebar -->
        <VBox prefWidth="250.0" spacing="5.0" style="-fx-background-color: #2d3748; -fx-padding: 20;">
            <children>
                <Label text="ADMIN PANEL" textFill="#A0AEC0" style="-fx-font-size: 12; -fx-font-weight: bold;">
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Label>

                <Button onAction="#openVenueBackoffice" prefWidth="200.0" text="🏢 Venue Management" style="-fx-background-color: #4a5568; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 15; -fx-font-size: 14; -fx-cursor: hand; -fx-background-radius: 8;">
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Button>

                <Button onAction="#openUserManagement" prefWidth="200.0"
                        text="👥 User Management" style="-fx-background-color:
                        transparent; -fx-text-fill: #cbd5e0; -fx-alignment:
                         CENTER_LEFT; -fx-padding: 15; -fx-font-size: 14; -fx-cursor: hand; -fx-background-radius: 8;">
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Button>

                <Button onAction="#openReservationManagement" prefWidth="200.0" text="📅 Reservations"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e0;
                         -fx-alignment: CENTER_LEFT; -fx-padding: 30; -fx-font-size: 14; -fx-cursor: hand; -fx-background-radius: 8;">
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>
</BorderPane>