{% extends 'base.html.twig' %}

{% block title %}Salle de Fête - Book Your Dream Venue{% endblock %}

{% block stylesheets %}
    
    <style>
        :root {
            --royal-blue: #1a237e;
            --luxury-gold: #ffd700;
            --glass-bg: rgba(255, 255, 255, 0.1);
            --glass-border: rgba(255, 255, 255, 0.2);
        }

        body {
            background: linear-gradient(135deg, var(--royal-blue) 0%, #3949ab 25%, #5c6bc0 50%, #7986cb 75%, #9fa8da 100%);
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* Animated background decorations */
        .bg-decoration {
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: -1;
            overflow: hidden;
        }

        .floating-element {
            position: absolute;
            opacity: 0.1;
            animation: float 6s ease-in-out infinite;
        }

        .balloon {
            width: 60px;
            height: 80px;
            background: linear-gradient(45deg, var(--luxury-gold), #ffed4e);
            border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
            top: 20%;
            left: 10%;
        }

        .balloon:before {
            content: '';
            position: absolute;
            width: 2px;
            height: 80px;
            background: rgba(255, 255, 255, 0.3);
            bottom: -80px;
            left: 50%;
            transform: translateX(-50%);
        }

        .champagne {
            width: 40px;
            height: 100px;
            background: linear-gradient(to bottom, var(--luxury-gold) 0%, #ffed4e 30%, #2e7d32 30%, #4caf50 100%);
            border-radius: 0 0 50% 50%;
            top: 60%;
            right: 15%;
            animation-delay: -2s;
        }

        .music-note {
            width: 50px;
            height: 50px;
            background: var(--luxury-gold);
            border-radius: 50% 0 50% 0;
            top: 80%;
            left: 80%;
            animation-delay: -4s;
        }

        .confetti {
            width: 20px;
            height: 20px;
            background: var(--luxury-gold);
            top: 10%;
            right: 30%;
            animation: confetti-fall 8s linear infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(5deg); }
        }

        @keyframes confetti-fall {
            0% { transform: translateY(-100vh) rotate(0deg); }
            100% { transform: translateY(100vh) rotate(360deg); }
        }

        /* Glassmorphism effects */
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        }

        .glass-navbar {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
        }

        /* Hero Section */
        .hero-section {
            padding: 120px 0 80px;
            text-align: center;
            color: white;
            position: relative;
        }

        .hero-title {
            font-size: 4rem;
            font-weight: 700;
            background: linear-gradient(45deg, white, var(--luxury-gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 2rem;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .hero-subtitle {
            font-size: 1.3rem;
            margin-bottom: 3rem;
            opacity: 0.9;
        }

        /* Sign In Form */
        .signin-card {
            max-width: 400px;
            margin: 0 auto 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            color: var(--luxury-gold);
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: block;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 15px 20px;
            color: white;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: var(--luxury-gold);
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
            outline: none;
            color: white;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        .form-select {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 15px 20px;
            color: white;
        }

        .form-select option {
            background: var(--royal-blue);
            color: white;
        }

        /* Buttons */
        .btn-signin {
            background: linear-gradient(45deg, var(--luxury-gold), #ffed4e);
            border: none;
            padding: 15px 30px;
            font-size: 1rem;
            font-weight: 700;
            color: var(--royal-blue);
            border-radius: 50px;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(255, 215, 0, 0.4);
        }

        .btn-signin:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(255, 215, 0, 0.6);
        }

        .btn-reserve {
            background: linear-gradient(45deg, var(--luxury-gold), #ffed4e);
            border: none;
            padding: 18px 40px;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--royal-blue);
            border-radius: 50px;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(255, 215, 0, 0.4);
        }

        .btn-reserve:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(255, 215, 0, 0.6);
        }

        .btn-reserve:before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
            transition: left 0.5s;
        }

        .btn-reserve:hover:before {
            left: 100%;
        }

        .btn-signout {
            background: rgba(220, 53, 69, 0.8);
            border: none;
            padding: 8px 20px;
            font-size: 0.9rem;
            font-weight: 600;
            color: white;
            border-radius: 25px;
            transition: all 0.3s ease;
        }

        .btn-signout:hover {
            background: rgba(220, 53, 69, 1);
            transform: translateY(-2px);
        }

        /* User Status */
        .user-status {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 1rem;
            margin-bottom: 2rem;
            text-align: center;
        }

        .user-avatar {
            width: 60px;
            height: 60px;
            background: var(--luxury-gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            font-size: 1.5rem;
            color: var(--royal-blue);
        }

        /* Features Section */
        .features-section {
            padding: 100px 0;
            background: rgba(255, 255, 255, 0.05);
        }

        .feature-icon {
            font-size: 3rem;
            color: var(--luxury-gold);
            margin-bottom: 1rem;
        }

        .feature-card {
            text-align: center;
            padding: 2rem;
            color: white;
            transition: transform 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-10px);
        }

        /* Venue Types */
        .venue-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin: 3rem 0;
        }

        .venue-card {
            position: relative;
            height: 250px;
            border-radius: 20px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .venue-card:hover {
            transform: scale(1.05);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .venue-card-bg {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, var(--royal-blue), #5c6bc0);
            opacity: 0.9;
        }

        .venue-card-content {
            position: relative;
            z-index: 2;
            padding: 2rem;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
        }

        .venue-icon {
            font-size: 4rem;
            color: var(--luxury-gold);
            margin-bottom: 1rem;
        }

        .venue-actions {
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.3s ease;
        }

        .venue-card:hover .venue-actions {
            opacity: 1;
            transform: translateY(0);
        }

        .venue-actions .btn {
            font-size: 0.8rem;
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            transition: all 0.3s ease;
        }

        .venue-actions .btn:hover {
            transform: scale(1.05);
        }

        .cart-status-indicator {
            position: sticky;
            top: 80px;
            z-index: 1000;
            animation: slideDown 0.5s ease-out;
        }

        @keyframes slideDown {
            from {
                transform: translateY(-100%);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .hero-title {
                font-size: 2.5rem;
            }
            
            .hero-subtitle {
                font-size: 1.1rem;
            }
            
            .btn-reserve {
                width: 100%;
            }
        }

        /* Floating particles */
        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: var(--luxury-gold);
            border-radius: 50%;
            animation: particle-float 10s linear infinite;
        }

        @keyframes particle-float {
            0% {
                transform: translateY(100vh) translateX(0);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                transform: translateY(-100vh) translateX(100px);
                opacity: 0;
            }
        }

        /* Navigation Styles */
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
        }

        .nav-link {
            font-weight: 500;
            margin: 0 0.5rem;
            color: white !important;
            transition: color 0.3s ease;
        }

        .nav-link:hover {
            color: var(--luxury-gold) !important;
        }

        /* Events Section */
        .events-section {
            padding: 80px 0;
            background: rgba(255, 255, 255, 0.05);
        }

        .event-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            transition: transform 0.3s ease;
        }

        .event-card:hover {
            transform: translateY(-5px);
        }

        /* Contact Section */
        .contact-section {
            padding: 80px 0;
        }

        .contact-info {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        /* Footer */
        .footer {
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding: 2rem 0;
            color: white;
        }

        /* Alert Messages */
        .alert {
            border-radius: 15px;
            border: none;
            backdrop-filter: blur(10px);
        }

        .alert-success {
            background: rgba(40, 167, 69, 0.2);
            color: #d4edda;
            border: 1px solid rgba(40, 167, 69, 0.3);
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.2);
            color: #f8d7da;
            border: 1px solid rgba(220, 53, 69, 0.3);
        }

        /* Modal Styles */
        .modal-content.glass-card {
            background: rgba(26, 35, 126, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
        }

        .modal-header {
            background: rgba(255, 255, 255, 0.1);
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px 20px 0 0;
        }

        .modal-body {
            background: rgba(255, 255, 255, 0.05);
        }

        /* Reservation Details */
        .reservation-details {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            padding: 1rem;
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Background Decorations -->
    <div class="bg-decoration">
        <div class="floating-element balloon"></div>
        <div class="floating-element champagne"></div>
        <div class="floating-element music-note"></div>
        <div class="floating-element confetti"></div>
        
        <!-- Floating particles -->
        <div class="particle" style="left: 10%; animation-delay: 0s;"></div>
        <div class="particle" style="left: 20%; animation-delay: 2s;"></div>
        <div class="particle" style="left: 30%; animation-delay: 4s;"></div>
        <div class="particle" style="left: 50%; animation-delay: 6s;"></div>
        <div class="particle" style="left: 70%; animation-delay: 8s;"></div>
        <div class="particle" style="left: 90%; animation-delay: 1s;"></div>
    </div>

    <!-- Navigation -->
    <nav class="glass-navbar fixed-top">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center">
                    <span style="font-size: 2rem; color: #ffd700;">🎉</span>
                    <span class="ms-2 text-white fw-bold fs-4">Salle de Fête</span>
                </div>
                <div class="d-none d-md-flex gap-4">
                    <a href="#venues" class="nav-link text-decoration-none">Venues</a>
                    <a href="#events" class="nav-link text-decoration-none">Events</a>
                    <a href="#contact" class="nav-link text-decoration-none">Contact</a>
                    <a href="{{ path('app_cart_demo') }}" class="nav-link text-decoration-none">
                        🛒 Cart Demo
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 text-center">
                    <h1 class="hero-title">
                        <span style="font-size: 3rem;">🎊</span> Your Perfect Celebration Awaits
                    </h1>
                    <p class="hero-subtitle">
                        Luxury event venues for unforgettable moments. From intimate gatherings to grand celebrations, 
                        we create the perfect atmosphere for your special day.
                    </p>
                    <div class="d-flex justify-content-center gap-3 mb-4">
                        <span style="font-size: 2rem;">🥂</span>
                        <span style="font-size: 2rem;">🎵</span>
                        <span style="font-size: 2rem;">✨</span>
                        <span style="font-size: 2rem;">🎈</span>
                        <span style="font-size: 2rem;">🎉</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Cart Status Indicator -->
    <div class="cart-status-indicator" id="cartStatusIndicator" style="display: none;">
        <div class="container">
            <div class="alert alert-info text-center mb-0">
                <span style="font-size: 1.2rem;">🛒</span>
                <span id="cartStatusText">Items in your cart</span>
                <button class="btn btn-sm btn-outline-primary ms-3" onclick="window.cart?.toggleCart()">
                    View Cart
                </button>
            </div>
        </div>
    </div>

    <!-- User Status Section -->
    {% if user %}
        <section class="py-3">
            <div class="container">
                <div class="user-status">
                    <div class="user-avatar">
                        <span>👤</span>
                    </div>
                    <h5 class="text-white mb-2">Welcome, {{ user.username }}!</h5>
                    <p class="text-white-50 mb-2">Role: {{ user.role|title }}</p>
                    <form method="POST" style="display: inline;">
                        <button type="submit" name="signout" class="btn btn-signout">Sign Out</button>
                    </form>
                </div>
            </div>
        </section>
    {% else %}
        <!-- Sign In Section -->
        <section class="py-3">
            <div class="container">
                <div class="signin-card">
                    <div class="glass-card p-4">
                        <h4 class="text-white text-center mb-3">
                            <span style="font-size: 1.5rem; color: #ffd700;">🔐</span>
                            Sign In to Book
                        </h4>
                        <form method="POST">
                            <div class="form-group">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" name="email" placeholder="your@email.com" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Password</label>
                                <input type="password" class="form-control" name="password" placeholder="Enter your password" required>
                            </div>
                            <div class="d-grid">
                                <button type="submit" name="signin" class="btn btn-signin">Sign In</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    {% endif %}

    <!-- Alert Messages -->
    {% if error %}
        <section class="py-2">
            <div class="container">
                <div class="alert alert-danger text-center">
                    <span style="font-size: 1.2rem;">⚠️</span> {{ error }}
                </div>
            </div>
        </section>
    {% endif %}

    {% if success %}
        <section class="py-2">
            <div class="container">
                <div class="alert alert-success text-center">
                    <span style="font-size: 1.2rem;">✅</span> {{ success }}
                </div>
            </div>
        </section>
    {% endif %}

    <!-- Booking Form Section (Only for authenticated users) -->
    {% if user %}
        <section class="py-5">
            <div class="container">
                <div class="text-center mb-5">
                    <h2 class="text-white mb-3">
                        <span style="font-size: 2rem; color: #ffd700;">🏰</span>
                        Available Venues
                    </h2>
                    <p class="text-white-50">Choose from our available celebration spaces</p>
                </div>

                <div class="row">
                    {% for venue in venues %}
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="glass-card h-100 p-4">
                                <div class="text-center mb-3">
                                    <div class="venue-icon mb-3">
                                        {% if venue.capacite > 150 %}
                                            🏰
                                        {% elseif venue.capacite > 100 %}
                                            💎
                                        {% elseif venue.capacite > 50 %}
                                            🌸
                                        {% else %}
                                            🎭
                                        {% endif %}
                                    </div>
                                    <h4 class="text-white mb-2">{{ venue.nom }}</h4>
                                    <p class="text-white-50 mb-3">{{ venue.description|default('Perfect venue for your celebration') }}</p>
                                </div>

                                <div class="venue-details mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-white-50">📍 Address:</span>
                                        <span class="text-white">{{ venue.adresse }}</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-white-50">👥 Capacity:</span>
                                        <span class="text-white">{{ venue.capacite }} guests</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-white-50">💰 Price:</span>
                                        <span class="text-warning fw-bold">{{ venue.prix }} DT</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-white-50">📅 Status:</span>
                                        {% if venue.disponible %}
                                            <span class="badge bg-success">Available</span>
                                        {% else %}
                                            <span class="badge bg-danger">Booked</span>
                                        {% endif %}
                                    </div>
                                </div>

                                {% if venue.disponible %}
                                    <div class="d-grid">
                                        <button class="btn btn-reserve" onclick="showBookingForm({{ venue.id }}, '{{ venue.nom }}', {{ venue.prix }})">
                                            <span style="font-size: 1.2rem; margin-right: 10px;">✨</span>
                                            Book This Venue
                                            <span style="font-size: 1.2rem; margin-left: 10px;">🎉</span>
                                        </button>
                                    </div>
                                {% else %}
                                    <div class="d-grid">
                                        <button class="btn btn-secondary" disabled>
                                            <span style="font-size: 1.2rem;">🔒</span>
                                            Currently Booked
                                        </button>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <div class="col-12 text-center">
                            <div class="glass-card p-5">
                                <h3 class="text-white mb-3">
                                    <span style="font-size: 2rem; color: #ffd700;">📋</span>
                                    No Venues Available
                                </h3>
                                <p class="text-white-50 fs-5">All our venues are currently booked. Please check back later!</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- User Reservations Section -->
        {% if userReservations|length > 0 %}
            <section class="py-5">
                <div class="container">
                    <div class="text-center mb-5">
                        <h2 class="text-white mb-3">
                            <span style="font-size: 2rem; color: #ffd700;">📋</span>
                            My Reservations
                        </h2>
                        <p class="text-white-50">Your booking history and upcoming events</p>
                    </div>

                    <div class="row">
                        {% for reservation in userReservations %}
                            <div class="col-lg-6 mb-4">
                                <div class="glass-card p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h5 class="text-white mb-0">{{ reservation.local.nom }}</h5>
                                        <span class="badge {% if reservation.statut == 'Confirmée' %}bg-success{% elseif reservation.statut == 'En attente' %}bg-warning{% else %}bg-secondary{% endif %}">
                                            {{ reservation.statut }}
                                        </span>
                                    </div>
                                    
                                    <div class="reservation-details">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-white-50">📅 Date:</span>
                                            <span class="text-white">{{ reservation.date|date('d/m/Y') }}</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-white-50">⏰ Time:</span>
                                            <span class="text-white">{{ reservation.heureDebut|date('H:i') }} - {{ reservation.heureFin|date('H:i') }}</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-white-50">💰 Price:</span>
                                            <span class="text-warning fw-bold">{{ reservation.prix }} DT</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-white-50">📍 Address:</span>
                                            <span class="text-white">{{ reservation.local.adresse }}</span>
