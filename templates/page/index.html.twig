    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Venue selection and booking
        function showBookingForm(venueId, venueName, venuePrice) {
            console.log('=== OPENING BOOKING FORM ===');
            console.log('Parameters received:', {venueId, venueName, venuePrice});
            
            // Set the hidden field values
            const venueIdField = document.getElementById('venue_id');
            const venueNameField = document.getElementById('venue_name');
            const venuePriceField = document.getElementById('venue_price');
            const venuePriceDisplayField = document.getElementById('venue_price_display');
            
            if (!venueIdField || !venueNameField || !venuePriceField || !venuePriceDisplayField) {
                console.error('One or more form fields not found!');
                return;
            }
            
            venueIdField.value = venueId;
            venueNameField.value = venueName;
            venuePriceField.value = venuePrice;
            venuePriceDisplayField.value = venuePrice + ' DT';
            
            // Verify the values were set
            console.log('Hidden fields set to:');
            console.log('venue_id:', venueIdField.value);
            console.log('venue_name:', venueNameField.value);
            console.log('venue_price:', venuePriceField.value);
            console.log('venue_price_display:', venuePriceDisplayField.value);
            
            // Double-check the form data
            const form = document.getElementById('bookingForm');
            const formData = new FormData(form);
            console.log('Form data after setting fields:');
            console.log('venue_id in form:', formData.get('venue_id'));
            console.log('prix in form:', formData.get('prix'));
            
            new bootstrap.Modal(document.getElementById('bookingModal')).show();
        }

        // Form submission handling
        document.getElementById('bookingForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            console.log('Form submitted!');
            
            // Get form data
            const formData = new FormData(this);
            const venueId = formData.get('venue_id');
            const date = formData.get('date');
            const heureDebut = formData.get('heure_debut');
            const heureFin = formData.get('heure_fin');
            const prix = formData.get('prix');
            const bookVenue = formData.get('book_venue');
            
            console.log('Form data:', {
                bookVenue,
                venueId,
                date,
                heureDebut,
                heureFin,
                prix
            });
            
            // Check if hidden fields have values
            console.log('Hidden field values:');
            console.log('venue_id field:', document.getElementById('venue_id').value);
            console.log('venue_price field:', document.getElementById('venue_price').value);
            
            // Validation
            if (!venueId || !date || !heureDebut || !heureFin || !prix) {
                console.log('Validation failed - missing fields');
                console.log('Venue ID is:', venueId ? venueId : 'NULL/EMPTY');
                console.log('Date is:', date ? date : 'NULL/EMPTY');
                console.log('Start time is:', heureDebut ? heureDebut : 'NULL/EMPTY');
                console.log('End time is:', heureFin ? heureFin : 'NULL/EMPTY');
                console.log('Price is:', prix ? prix : 'NULL/EMPTY');
                showNotification('Please fill in all required fields', 'error');
                return;
            }

            // Check if end time is after start time
            if (heureFin <= heureDebut) {
                console.log('Time validation failed');
                showNotification('End time must be after start time', 'error');
                return;
            }

            // Check if date is not in the past
            const selectedDate = new Date(date);
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            
            if (selectedDate < today) {
                console.log('Date validation failed');
                showNotification('Event date cannot be in the past', 'error');
                return;
            }

            console.log('Form validation passed, submitting...');
            console.log('Final form data being sent:', {
                venue_id: venueId,
                date: date,
                heure_debut: heureDebut,
                heure_fin: heureFin,
                prix: prix,
                book_venue: bookVenue
            });
            
            // Submit form
            this.submit();
        });

        // Show notification function
        function showNotification(message, type = 'info') {
            // Create notification element
            const notification = document.createElement('div');
            notification.className = `alert alert-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'} position-fixed`;
            notification.style.cssText = `
                top: 100px;
                right: 20px;
                z-index: 10000;
                min-width: 300px;
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 15px;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            `;
            notification.innerHTML = `
                <div class="d-flex align-items-center">
                    <div class="me-2">${message}</div>
                    <button type="button" class="btn-close btn-close-white ms-auto" onclick="this.parentElement.parentElement.remove()"></button>
                </div>
            `;
            
            document.body.appendChild(notification);
            
            // Auto remove after 5 seconds
            setTimeout(() => {
                if (notification.parentElement) {
                    notification.remove();
                }
            }, 5000);
        }

        // Add more floating particles dynamically
        function createParticle() {
            const particle = document.createElement('div');
            particle.className = 'particle';
            particle.style.left = Math.random() * 100 + '%';
            particle.style.animationDelay = Math.random() * 10 + 's';
            particle.style.animationDuration = (Math.random() * 5 + 8) + 's';
            document.querySelector('.bg-decoration').appendChild(particle);
            
            setTimeout(() => {
                particle.remove();
            }, 13000);
        }

        // Create particles periodically
        setInterval(createParticle, 2000);

        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add hover effects to venue cards
        document.querySelectorAll('.venue-card').forEach(card => {
            card.addEventListener('click', function() {
                const venueType = this.querySelector('h4').textContent;
                const venueSelect = document.querySelector('select[name="venue"]');
                
                if (venueSelect) {
                    // Map display names to option values
                    const venueMap = {
                        'Grand Ballroom': 'grand_ballroom',
                        'Crystal Hall': 'crystal_hall',
                        'Garden Pavilion': 'garden_pavilion'
                    };
                    
                    if (venueMap[venueType]) {
                        venueSelect.value = venueMap[venueType];
                        venueSelect.style.borderColor = 'var(--luxury-gold)';
                        venueSelect.style.boxShadow = '0 0 20px rgba(255, 215, 0, 0.3)';
                        
                        // Scroll to booking form
                        document.querySelector('.booking-card')?.scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });
                    }
                }
            });
        });

        // Update cart status indicator
        function updateCartStatusIndicator() {
            const indicator = document.getElementById('cartStatusIndicator');
            const statusText = document.getElementById('cartStatusText');
            
            if (window.cart && window.cart.items.length > 0) {
                const itemCount = window.cart.items.length;
                const total = window.cart.total;
                statusText.textContent = `${itemCount} item(s) in your cart - Total: ${total.toFixed(2)}€`;
                indicator.style.display = 'block';
            } else {
                indicator.style.display = 'none';
            }
        }

        // Listen for cart updates
        document.addEventListener('DOMContentLoaded', function() {
            // Wait for cart to be initialized
            setTimeout(() => {
                if (window.cart) {
                    // Override the updateCart method to also update the indicator
                    const originalUpdateCart = window.cart.updateCart;
                    window.cart.updateCart = function() {
                        originalUpdateCart.call(this);
                        updateCartStatusIndicator();
                    };
                    
                    // Initial update
                    updateCartStatusIndicator();
                }
            }, 1000);
        });

        // Function to test form data
        function testFormData() {
            const form = document.getElementById('bookingForm');
            const formData = new FormData(form);
            let testMessage = 'Form Data (Hidden Fields):\n';
            testMessage += 'venue_id: ' + formData.get('venue_id') + '\n';
            testMessage += 'prix: ' + formData.get('prix') + '\n';
            testMessage += 'date: ' + formData.get('date') + '\n';
            testMessage += 'heure_debut: ' + formData.get('heure_debut') + '\n';
            testMessage += 'heure_fin: ' + formData.get('heure_fin') + '\n';
            testMessage += 'guests: ' + formData.get('guests') + '\n';
            testMessage += 'notes: ' + formData.get('notes') + '\n';
            testMessage += 'book_venue: ' + formData.get('book_venue');

            alert(testMessage);
            console.log('Form Data (Hidden Fields):', {
                venue_id: formData.get('venue_id'),
                prix: formData.get('prix'),
                date: formData.get('date'),
                heure_debut: formData.get('heure_debut'),
                heure_fin: formData.get('heure_fin'),
                guests: formData.get('guests'),
                notes: formData.get('notes'),
                book_venue: formData.get('book_venue')
            });
        }

        // Function to add venue to cart from form
        function addToCartFromForm() {
            const form = document.getElementById('bookingForm');
            const formData = new FormData(form);
            
            // Validate required fields
            const date = formData.get('date');
            const heureDebut = formData.get('heure_debut');
            const heureFin = formData.get('heure_fin');
            const guests = formData.get('guests');
            
            if (!date || !heureDebut || !heureFin || !guests) {
                alert('Please fill in all required fields before adding to cart!');
                return;
            }
            
            // Create cart item
            const cartItem = {
                id: formData.get('venue_id'),
                venueName: document.getElementById('venue_name').value,
                prix: formData.get('prix'),
                date: date,
                heureDebut: heureDebut,
                heureFin: heureFin,
                guests: guests,
                notes: formData.get('notes') || ''
            };
            
            // Add to cart
            if (window.cart) {
                window.cart.addToCart(cartItem);
                
                // Close the modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('bookingModal'));
                if (modal) {
                    modal.hide();
                }
                
                // Show success message
                showNotification('Venue added to cart successfully! 🎉', 'success');
            } else {
                alert('Cart system not available. Please refresh the page.');
            }
        }

        // Function to quickly add venue to cart (with default values)
        function quickAddToCart(venueName, prix) {
            // Create a cart item with default values
            const cartItem = {
                id: Date.now(), // Generate a unique ID
                venueName: venueName,
                prix: prix,
                date: new Date().toISOString().split('T')[0], // Today's date
                heureDebut: '18:00', // Default start time
                heureFin: '23:00', // Default end time
                guests: 50, // Default guest count
                notes: 'Added via quick add'
            };
            
            // Add to cart
            if (window.cart) {
                window.cart.addToCart(cartItem);
                showNotification(`${venueName} added to cart! 🎉`, 'success');
            } else {
                alert('Cart system not available. Please refresh the page.');
            }
        }
    </script>
