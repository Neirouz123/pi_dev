{% extends 'base.html.twig' %}

{% block title %}Material Kit 3 - Author{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 font-weight-bold mb-4">Meet the Creator</h1>
                <p class="lead mb-4">The passionate developer behind Material Kit 3</p>
            </div>
        </div>
    </div>
</section>

<!-- Author Profile -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-4">
                <div class="card border-0 shadow-lg">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center mb-4" style="width: 150px; height: 150px;">
                            <i class="material-symbols-rounded text-white" style="font-size: 4rem;">person</i>
                        </div>
                        <h3 class="mb-2">Alex Johnson</h3>
                        <p class="text-muted mb-3">Lead Developer & Designer</p>
                        <p class="text-muted mb-4">Passionate about creating beautiful, functional, and accessible web experiences.</p>
                        
                        <div class="d-flex justify-content-center gap-2 mb-4">
                            <a href="#" class="btn btn-outline-primary btn-sm">
                                <i class="material-symbols-rounded">facebook</i>
                            </a>
                            <a href="#" class="btn btn-outline-primary btn-sm">
                                <i class="material-symbols-rounded">twitter</i>
                            </a>
                            <a href="#" class="btn btn-outline-primary btn-sm">
                                <i class="material-symbols-rounded">linkedin</i>
                            </a>
                            <a href="#" class="btn btn-outline-primary btn-sm">
                                <i class="material-symbols-rounded">github</i>
                            </a>
                        </div>
                        
                        <div class="row text-center">
                            <div class="col-6">
                                <h5 class="mb-1">8+</h5>
                                <small class="text-muted">Years Experience</small>
                            </div>
                            <div class="col-6">
                                <h5 class="mb-1">50+</h5>
                                <small class="text-muted">Projects</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">About Me</h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="lead mb-4">Hi, I'm Alex! I'm a full-stack developer with a passion for creating beautiful and functional web applications.</p>
                        
                        <p class="mb-4">With over 8 years of experience in web development, I've worked on projects ranging from small business websites to large-scale enterprise applications. My expertise includes frontend frameworks like React and Vue.js, backend technologies like Node.js and PHP, and design systems like Material Design.</p>
                        
                        <p class="mb-4">Material Kit 3 was born from my desire to help other developers create beautiful user interfaces quickly and efficiently. I believe that great design should be accessible to everyone, which is why I've made this kit completely free and open source.</p>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="mb-3">Education</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <strong>B.S. Computer Science</strong><br>
                                        <small class="text-muted">Stanford University, 2016</small>
                                    </li>
                                    <li class="mb-2">
                                        <strong>M.S. Software Engineering</strong><br>
                                        <small class="text-muted">MIT, 2018</small>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="mb-3">Certifications</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <strong>AWS Certified Developer</strong><br>
                                        <small class="text-muted">Amazon Web Services</small>
                                    </li>
                                    <li class="mb-2">
                                        <strong>Google Cloud Professional</strong><br>
                                        <small class="text-muted">Google Cloud Platform</small>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

