{% extends 'base.html.twig' %}

{% block title %}Material Kit 3 - Landing Page{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 font-weight-bold mb-4">Build Beautiful Websites Faster</h1>
                <p class="lead mb-4">Material Kit 3 is the most comprehensive UI kit built on Bootstrap 5. Create stunning web applications in minutes, not hours.</p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="{{ path('app_presentation') }}" class="btn btn-outline-light btn-lg">View Demo</a>
                </div>
                <div class="d-flex align-items-center text-white-50">
                    <div class="me-4">
                        <i class="material-symbols-rounded me-2">check_circle</i>
                        <span>Free Forever</span>
                    </div>
                    <div class="me-4">
                        <i class="material-symbols-rounded me-2">check_circle</i>
                        <span>No Credit Card</span>
                    </div>
                    <div>
                        <i class="material-symbols-rounded me-2">check_circle</i>
                        <span>Instant Access</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="card border-0 shadow-lg">
                    <div class="card-body p-5">
                        <i class="material-symbols-rounded text-primary mb-4" style="font-size: 4rem;">dashboard</i>
                        <h3>Material Kit 3</h3>
                        <p class="text-muted">The ultimate UI kit for modern web applications</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center mb-5">
                <h2 class="mb-4">Why Choose Material Kit 3?</h2>
                <p class="lead text-muted">Everything you need to build modern web applications</p>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 text-center">
                        <i class="material-symbols-rounded text-primary mb-3" style="font-size: 3rem;">speed</i>
                        <h5 class="card-title">Lightning Fast</h5>
                        <p class="card-text text-muted">Optimized for performance with minimal CSS and JavaScript. Load times under 2 seconds.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 text-center">
                        <i class="material-symbols-rounded text-success mb-3" style="font-size: 3rem;">devices</i>
                        <h5 class="card-title">Fully Responsive</h5>
                        <p class="card-text text-muted">Perfect on all devices - desktop, tablet, and mobile. No additional configuration needed.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 text-center">
                        <i class="material-symbols-rounded text-warning mb-3" style="font-size: 3rem;">code</i>
                        <h5 class="card-title">Clean Code</h5>
                        <p class="card-text text-muted">Well-structured, documented, and maintainable code that follows best practices.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 text-center">
                        <i class="material-symbols-rounded text-info mb-3" style="font-size: 3rem;">palette</i>
                        <h5 class="card-title">Beautiful Design</h5>
                        <p class="card-text text-muted">Modern, clean, and professional design that follows Material Design principles.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 text-center">
                        <i class="material-symbols-rounded text-danger mb-3" style="font-size: 3rem;">support_agent</i>
                        <h5 class="card-title">24/7 Support</h5>
                        <p class="card-text text-muted">Comprehensive documentation, tutorials, and community support to help you succeed.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 text-center">
                        <i class="material-symbols-rounded text-primary mb-3" style="font-size: 3rem;">update</i>
                        <h5 class="card-title">Regular Updates</h5>
                        <p class="card-text text-muted">Continuous improvements and new features added regularly to keep you ahead.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3 mb-4">
                <h2 class="text-primary mb-3">1.6M+</h2>
                <h5>Active Users</h5>
                <p class="text-muted">Developers worldwide trust Material Kit</p>
            </div>
            <div class="col-md-3 mb-4">
                <h2 class="text-primary mb-3">70+</h2>
                <h5>Components</h5>
                <p class="text-muted">Ready-to-use UI components</p>
            </div>
            <div class="col-md-3 mb-4">
                <h2 class="text-primary mb-3">15+</h2>
                <h5>Design Blocks</h5>
                <p class="text-muted">Pre-built page sections</p>
            </div>
            <div class="col-md-3 mb-4">
                <h2 class="text-primary mb-3">99.9%</h2>
                <h5>Uptime</h5>
                <p class="text-muted">Reliable and stable performance</p>
            </div>
        </div>
    </div>
</section>

