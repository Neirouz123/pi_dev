                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                <i class="material-symbols-rounded text-white">person</i>
                            </div>
                            <div>
                                <h6 class="mb-0">David Rodriguez</h6>
                                <small class="text-muted">Full Stack Developer</small>
                            </div>
                        </div>
                        <p class="card-text">"Perfect for rapid prototyping. The responsive design works flawlessly across all devices."</p>
                        <div class="text-warning">
                            <i class="material-symbols-rounded">star</i>
                            <i class="material-symbols-rounded">star</i>
                            <i class="material-symbols-rounded">star</i>
                            <i class="material-symbols-rounded">star</i>
                            <i class="material-symbols-rounded">star</i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="mb-4">Ready to Build Something Amazing?</h2>
                <p class="lead mb-4">Join 1.6 million developers who are already using Material Kit 3</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="{{ path('app_contact_us') }}" class="btn btn-outline-light btn-lg">Contact Sales</a>
                </div>
                <p class="mt-4 text-white-50">No credit card required • Free forever • Instant access</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
