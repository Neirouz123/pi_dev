{% extends 'back.html.twig' %}

{% block title %}Créer un Local{% endblock %}

{% block body %}
<div class="container-fluid py-5" style="background-color:#fff; min-height: 100vh;">
    <div class="row justify-content-center align-items-center h-100">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-lg border-0">
                
                {# Header #}
                <div class="card-header bg-primary text-white py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="mb-0" style="font-size: 1.8rem; font-weight: 600;">
                            <i class="fas fa-building me-2"></i>NOUVEAU LOCAL
                        </h2>
                        <a href="{{ path('app_local_index') }}" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-2"></i>Retour
                        </a>
                    </div>
                </div>

                {# Formulaire #}
                <div class="card-body p-5">
                    {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}

                    <div class="mb-4">
                        {{ form_label(form.nom, "Nom du Local", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.nom, {
                            'attr': {
                                'class': 'form-control form-control-lg py-3',
                                'placeholder': 'Ex: Salle de conférence',
                                'required': true
                            }
                        }) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.adresse, "Adresse", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.adresse, {
                            'attr': {
                                'class': 'form-control py-3',
                                'placeholder': 'Ex: Avenue Habib Bourguiba, Tunis',
                                'required': true
                            }
                        }) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.description, "Description", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.description, {
                            'attr': {
                                'class': 'form-control',
                                'rows': 4,
                                'placeholder': 'Décrire le local...',
                                'required': true
                            }
                        }) }}
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            {{ form_label(form.capacite, "Capacité", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.capacite, {
                                'attr': {
                                    'class': 'form-control py-3',
                                    'min': 1,
                                    'required': true
                                }
                            }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.prix, "Prix (DT)", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.prix, {
                                'attr': {
                                    'class': 'form-control py-3',
                                    'min': 0,
                                    'required': true
                                }
                            }) }}
                        </div>
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.disponible, "Disponible", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.disponible, {
                            'attr': {
                                'class': 'form-check-input ms-2'
                            }
                        }) }}
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-5">
                        <button type="submit" class="btn btn-primary btn-lg px-5 py-3">
                            <i class="fas fa-save me-2"></i>Enregistrer
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
