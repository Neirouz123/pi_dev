{% extends 'back.html.twig' %}

{% block title %}Détail du Local{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0"><i class="fas fa-building me-2"></i>Détails du Local</h3>
                <a href="{{ path('app_local_index') }}" class="btn btn-light btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr>
                        <th style="width: 200px;">ID</th>
                        <td>{{ local.id }}</td>
                    </tr>
                    <tr>
                        <th>Nom</th>
                        <td>{{ local.nom }}</td>
                    </tr>
                    <tr>
                        <th>Adresse</th>
                        <td>{{ local.adresse }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ local.description }}</td>
                    </tr>
                    <tr>
                        <th>Capacité</th>
                        <td>{{ local.capacite }}</td>
                    </tr>
                    <tr>
                        <th>Prix</th>
                        <td>{{ local.prix }} DT</td>
                    </tr>
                    <tr>
                        <th>Disponible</th>
                        <td>
                            {% if local.disponible %}
                                <span class="badge bg-success">✅ Oui</span>
                            {% else %}
                                <span class="badge bg-danger">❌ Non</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Créé le</th>
                        <td>{{ local.createdAt ? local.createdAt|date('Y-m-d H:i:s') : '-' }}</td>
                    </tr>
                    <tr>
                        <th>Modifié le</th>
                        <td>{{ local.updatedAt ? local.updatedAt|date('Y-m-d H:i:s') : '-' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-light text-end">
            <a href="{{ path('app_local_edit', {'id': local.id}) }}" class="btn btn-warning me-2">
                <i class="fas fa-edit me-1"></i> Modifier
            </a>
            {{ include('local/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
