{% extends 'back.html.twig' %}

{% block title %}Détail de la Réservation{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0"><i class="fas fa-calendar-check me-2"></i>Détails de la Réservation</h3>
                <a href="{{ path('app_reservation_controller_c_index') }}" class="btn btn-light btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr>
                        <th style="width: 200px;">ID</th>
                        <td>{{ reservation.id }}</td>
                    </tr>
                    <tr>
                        <th>Date</th>
                        <td>{{ reservation.date ? reservation.date|date('Y-m-d') : '-' }}</td>
                    </tr>
                    <tr>
                        <th>Heure Début</th>
                        <td>{{ reservation.heureDebut ? reservation.heureDebut|date('H:i:s') : '-' }}</td>
                    </tr>
                    <tr>
                        <th>Heure Fin</th>
                        <td>{{ reservation.heureFin ? reservation.heureFin|date('H:i:s') : '-' }}</td>
                    </tr>
                    <tr>
                        <th>Prix</th>
                        <td>{{ reservation.prix }} DT</td>
                    </tr>
                    <tr>
                        <th>Confirmée</th>
                        <td>
                            {% if reservation.isConfirmee %}
                                <span class="badge bg-success">✅ Oui</span>
                            {% else %}
                                <span class="badge bg-danger">❌ Non</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Statut</th>
                        <td>
                            <span class="badge bg-info text-dark">{{ reservation.statut }}</span>
                        </td>
                    </tr>
                    <tr>
                        <th>Créée le</th>
                        <td>{{ reservation.createdAt ? reservation.createdAt|date('Y-m-d H:i:s') : '-' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-light text-end">
            <a href="{{ path('app_reservation_controller_c_edit', {'id': reservation.id}) }}" class="btn btn-warning me-2">
                <i class="fas fa-edit me-1"></i> Modifier
            </a>
            {{ include('reservation_controller_c/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
